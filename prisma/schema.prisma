generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id        String   @id
  name      String
  created_at DateTime @default(now())
  server_updated_at DateTime @default(now())

  shops  Shop[]
  users  User[]

  accounts     Account[]
  subscriptions Subscription[]
  audit_events  AuditEvent[]
  notifications Notification[]
}

model Account {
  id            String   @id
  business_id   String
  email         String   @unique
  password_hash String
  role          String   @default("owner") // owner | manager | staff
  active        Boolean  @default(true)
  created_at    DateTime @default(now())

  business     Business     @relation(fields: [business_id], references: [id])
  sessions     Session[]
  audit_events AuditEvent[]

  @@index([business_id])
}

model Session {
  id         String    @id
  account_id String
  token_hash String    @unique
  created_at DateTime  @default(now())
  expires_at DateTime
  revoked_at DateTime?

  account Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([account_id])
}

model Subscription {
  id                String    @id
  business_id       String    @unique
  plan              String    @default("basic")
  status            String    @default("trialing") // trialing | active | past_due | canceled
  trial_ends_at     DateTime?
  current_period_end DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  business Business @relation(fields: [business_id], references: [id])
}

model AuditEvent {
  id          String   @id
  business_id String
  account_id  String?
  action      String
  target_type String?
  target_id   String?
  metadata    String   @default("{}")
  created_at  DateTime @default(now())

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  account  Account? @relation(fields: [account_id], references: [id], onDelete: SetNull)

  @@index([business_id, created_at])
  @@index([action])
}

model Notification {
  id          String   @id
  business_id String
  channel     String // email | sms | whatsapp | push
  recipient   String
  subject     String
  body        String
  status      String   @default("pending") // pending | sent | failed
  created_at  DateTime @default(now())
  sent_at     DateTime?
  error       String?

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id, status])
}

model Shop {
  id          String   @id
  business_id String
  name        String
  shop_code   String   @unique
  momo_number String   @default("")
  currency    String   @default("UGX")
  active      Boolean  @default(true)
  server_updated_at DateTime @default(now())

  business     Business    @relation(fields: [business_id], references: [id])
  users        User[]
  products     Product[]
  customers    Customer[]
  shifts       Shift[]
  sales        Sale[]
  stock_movements StockMovement[]
  deni_ledger  DeniLedger[]
  cash_movements CashMovement[]
  devices      Device[]
  warehouses   Warehouse[]
  batches      Batch[]
  payments     Payment[]
  storefronts  Storefront[]
  store_orders StoreOrder[]
  reviews      Review[]
  channel_syncs ChannelSync[]
  merchant_profile MerchantProfile?
  report_schedules ReportSchedule[]

  @@index([business_id])
  @@index([shop_code])
}

model User {
  id          String   @id
  business_id String
  shop_id     String?
  name        String
  role        String   // "owner" | "attendant"
  pin_hash    String
  active      Boolean  @default(true)
  server_updated_at DateTime @default(now())

  business Business @relation(fields: [business_id], references: [id])
  shop     Shop?    @relation(fields: [shop_id], references: [id])

  sales      Sale[]
  stock_movements StockMovement[]
  deni_ledger DeniLedger[]
  cash_movements CashMovement[]

  @@index([business_id])
  @@index([shop_id])
  @@index([business_id, shop_id])
}

model Product {
  id            String   @id
  shop_id       String
  name          String
  unit          String
  sku_code      String   @default("")
  selling_price Int
  buying_price  Int
  stock_qty     Int      @default(0)
  is_fast_mover Boolean  @default(false)
  photo_url     String   @default("")
  active        Boolean  @default(true)
  brand         String   @default("")
  barcode       String   @default("")
  reorder_level Int      @default(5)
  expiry_tracked Boolean @default(false)
  warehouse_id  String?
  updated_at    DateTime @default(now())
  server_updated_at DateTime @default(now())

  shop          Shop    @relation(fields: [shop_id], references: [id])
  sale_lines    SaleLine[]
  stock_movements StockMovement[]
  batches       Batch[]

  @@index([shop_id])
  @@index([shop_id, name])
  @@index([shop_id, barcode])
}

model Warehouse {
  id         String   @id
  shop_id    String
  name       String
  active     Boolean  @default(true)
  created_at DateTime @default(now())

  shop   Shop    @relation(fields: [shop_id], references: [id])
  batches Batch[]

  @@index([shop_id])
}

model Batch {
  id           String    @id
  shop_id      String
  product_id   String
  warehouse_id String?
  quantity     Int       @default(0)
  expiry_date  DateTime?
  created_at   DateTime  @default(now())

  shop      Shop       @relation(fields: [shop_id], references: [id])
  product   Product    @relation(fields: [product_id], references: [id])
  warehouse Warehouse? @relation(fields: [warehouse_id], references: [id])

  @@index([shop_id, product_id])
  @@index([expiry_date])
}

model Payment {
  id           String    @id
  shop_id      String
  sale_id      String
  method       String
  amount       Int
  reference    String    @default("")
  status       String    @default("pending") // pending | confirmed | reconciled
  confirmed_at DateTime?
  created_at   DateTime  @default(now())

  shop Shop @relation(fields: [shop_id], references: [id])

  @@index([shop_id, sale_id])
  @@index([shop_id, method])
  @@index([status])
}

model ReportSchedule {
  id          String   @id
  shop_id     String
  frequency   String
  recipient   String
  enabled     Boolean  @default(true)
  last_sent_at DateTime?
  created_at  DateTime @default(now())

  shop Shop @relation(fields: [shop_id], references: [id])

  @@index([shop_id, enabled])
}

model ChannelSync {
  id         String   @id
  shop_id    String
  channel    String
  product_id String
  status     String
  note       String   @default("")
  created_at DateTime @default(now())

  shop Shop @relation(fields: [shop_id], references: [id])

  @@index([shop_id, channel])
}

model MerchantProfile {
  id         String   @id
  shop_id    String   @unique
  slug       String   @unique
  category   String
  town       String
  active     Boolean  @default(true)
  created_at DateTime @default(now())

  shop Shop @relation(fields: [shop_id], references: [id])

  @@index([category, town])
}

model Storefront {
  id          String   @id
  shop_id     String   @unique
  slug        String   @unique
  title       String
  description String   @default("")
  active      Boolean  @default(true)
  created_at  DateTime @default(now())

  shop Shop @relation(fields: [shop_id], references: [id])

  @@index([slug])
}

model StoreOrder {
  id             String    @id
  shop_id        String
  slug           String
  customer_phone String
  delivery_band  String
  subtotal       Int
  delivery_fee   Int
  total          Int
  status         String    @default("pending")
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  shop  Shop            @relation(fields: [shop_id], references: [id])
  items StoreOrderItem[]

  @@index([shop_id, created_at])
  @@index([status])
}

model StoreOrderItem {
  id         String @id
  order_id   String
  product_id String
  name       String
  quantity   Int
  line_total Int

  order StoreOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
}

model Review {
  id         String   @id
  shop_id    String
  customer   String
  rating     Int
  comment    String
  approved   Boolean  @default(false)
  created_at DateTime @default(now())

  shop Shop @relation(fields: [shop_id], references: [id])

  @@index([shop_id, approved])
}

model StockTransfer {
  id            String    @id
  business_id   String
  from_shop_id  String
  to_shop_id    String
  lines         Json
  status        String    @default("pending")
  created_at    DateTime  @default(now())
  completed_at  DateTime?

  @@index([business_id, created_at])
  @@index([from_shop_id])
  @@index([to_shop_id])
}

model Customer {
  id       String  @id
  shop_id  String
  name     String
  phone    String  @default("")
  notes    String  @default("")
  balance  Int     @default(0)
  server_updated_at DateTime @default(now())

  shop        Shop         @relation(fields: [shop_id], references: [id])
  sales       Sale[]
  deni_ledger DeniLedger[]

  @@index([shop_id])
  @@index([shop_id, name])
}

model Shift {
  id             String    @id
  shop_id        String
  user_id        String
  opened_at      DateTime  @default(now())
  closed_at      DateTime?
  opening_float  Int       @default(0)
  counted_cash   Int?
  expected_cash  Int?
  variance       Int?
  status         String    @default("open") // "open" | "closed"

  shop           Shop      @relation(fields: [shop_id], references: [id])
  sales          Sale[]
  cash_movements CashMovement[]

  @@index([shop_id])
  @@index([shop_id, status])
}

model Sale {
  id          String   @id
  shop_id     String
  shift_id    String
  user_id     String
  customer_id String?
  created_at  DateTime @default(now())
  status      String   @default("completed") // "completed" | "voided"
  void_reason String   @default("")
  total       Int
  note        String   @default("")

  shop        Shop      @relation(fields: [shop_id], references: [id])
  shift       Shift     @relation(fields: [shift_id], references: [id])
  user        User      @relation(fields: [user_id], references: [id])
  customer    Customer? @relation(fields: [customer_id], references: [id])
  sale_lines  SaleLine[]
  tenders     Tender[]

  @@index([shop_id])
  @@index([shift_id])
  @@index([user_id])
  @@index([customer_id])
  @@index([shop_id, created_at])
}

model SaleLine {
  id                     String @id
  sale_id                String
  product_id             String
  qty                    Int
  unit_price             Int
  line_total             Int
  buying_price_snapshot  Int

  sale    Sale    @relation(fields: [sale_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@index([sale_id])
  @@index([product_id])
}

model Tender {
  id              String @id
  sale_id         String
  method          String // "cash" | "mtn_momo" | "airtel_money" | "credit"
  amount          Int
  amount_tendered Int
  change          Int

  sale Sale @relation(fields: [sale_id], references: [id])

  @@index([sale_id])
  @@index([method])
}

model StockMovement {
  id         String   @id
  shop_id    String
  product_id String
  type       String   // "sale" | "receive" | "adjust" | "void"
  qty_delta  Int
  reason     String   @default("")
  user_id    String
  created_at DateTime @default(now())
  ref_id     String   @default("")

  shop    Shop    @relation(fields: [shop_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])

  @@index([shop_id])
  @@index([product_id])
  @@index([type])
  @@index([ref_id])
  @@index([shop_id, product_id])
}

model DeniLedger {
  id          String   @id
  shop_id     String
  customer_id String
  type        String   // "sale_credit" | "collection" | "void"
  amount      Int
  sale_id     String   @default("")
  user_id     String
  created_at  DateTime @default(now())
  note        String   @default("")

  shop     Shop     @relation(fields: [shop_id], references: [id])
  customer Customer @relation(fields: [customer_id], references: [id])
  user     User     @relation(fields: [user_id], references: [id])

  @@index([shop_id])
  @@index([customer_id])
  @@index([shop_id, customer_id])
}

model CashMovement {
  id         String   @id
  shop_id    String
  shift_id   String
  type       String   // "draw" | "expense" | "collection_cash"
  amount     Int
  reason     String
  user_id    String
  created_at DateTime @default(now())

  shop  Shop  @relation(fields: [shop_id], references: [id])
  shift Shift @relation(fields: [shift_id], references: [id])
  user  User  @relation(fields: [user_id], references: [id])

  @@index([shop_id])
  @@index([shift_id])
  @@index([type])
}

model Device {
  id       String @id
  shop_id  String
  token    String @unique
  name     String

  shop Shop @relation(fields: [shop_id], references: [id])

  @@index([shop_id])
  @@index([token])
}

model SyncCursor {
  id        String   @id
  shop_id   String
  cursor    BigInt   @default(0)
  updated_at DateTime @default(now())

  @@unique([shop_id])
}
