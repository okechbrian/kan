# Public site URL (no trailing slash). Temporary Vercel URL until a domain is bought.
NEXT_PUBLIC_SITE_URL="https://kan-sme.vercel.app"

# Postgres for thin sync / later platform. Leave unset to sell offline only.
# Supabase or Vercel Postgres both work.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kan?sslmode=require"

